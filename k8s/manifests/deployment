---
# ============================================================================
#  DEPLOYMENT ФРОНТЕНДА — с построчными комментариями
# ============================================================================
# Deployment управляет набором одинаковых подов: держит нужное число реплик,
# поднимает упавшие, умеет бесшовно обновлять версию.
# ============================================================================

apiVersion: apps/v1
# ^ Версия API Kubernetes для этого объекта.
#   "apps" — группа API (туда входят Deployment, StatefulSet, DaemonSet).
#   "v1" — стабильная версия. Для Deployment ВСЕГДА apps/v1.

kind: Deployment
# ^ Тип объекта. Здесь — Deployment.
#   Бывают также Pod, Service, StatefulSet, DaemonSet и т.д.

metadata:
  # metadata — "паспорт" САМОГО деплоймента (не подов внутри него).
  name: frontend
  # ^ Имя деплоймента в кластере. По нему обращаешься:
  #   kubectl get deployment frontend.  Уникально в пределах namespace.

  namespace: my-app
  # ^ В каком пространстве имён (namespace) живёт объект.
  #   Namespace изолирует ресурсы, как папки.
  #   ВАЖНО: namespace должен существовать ЗАРАНЕЕ, иначе apply упадёт.
  #   Создать: kubectl create namespace my-app

  labels:
    app: frontend
    # ^ Метки (ключ-значение) НА САМОМ деплойменте. Для группировки и поиска:
    #   kubectl get deploy -l app=frontend
    #   Это метки деплоймента — НЕ путать с метками подов ниже (template).

spec:
  # spec — желаемое состояние. Kubernetes приводит реальность к нему.

  replicas: 2
  # ^ Сколько одинаковых подов держать запущенными.
  #   Упадёт один — Kubernetes поднимет новый, чтобы снова стало 2.
  #   Это и есть отказоустойчивость.

  selector:
    # selector — как деплоймент находит "свои" поды.
    # Он управляет подами, чьи метки совпадают с matchLabels.
    matchLabels:
    # ^ ИСПРАВЛЕНО: было "matchlabels" — НЕ работает!
    #   YAML чувствителен к регистру, нужно matchLabels (большая L).
      app: frontend
      # ^ КЛЮЧЕВАЯ СВЯЗКА: эта метка ДОЛЖНА совпадать с метками подов
      #   в template.metadata.labels ниже. Деплоймент говорит
      #   "я управляю подами с меткой app: frontend" — и поды обязаны
      #   её иметь. Не совпадут → ошибка валидации.

  template:
    # template — ШАБЛОН пода. Всё ниже описывает, как выглядит один под,
    # который деплоймент будет создавать (в количестве replicas штук).
    metadata:
      labels:
        app: frontend
        # ^ Метки, которые получит КАЖДЫЙ создаваемый под.
        #   Именно их ловит selector.matchLabels выше — поэтому
        #   app: frontend здесь ОБЯЗАН совпасть с matchLabels.

    spec:
      # spec пода — что у него внутри.
      containers:
        # Список контейнеров в поде (через "-" — это массив,
        # контейнеров может быть несколько).
        - name: frontend
          # ^ Имя контейнера внутри пода. Видно в логах:
          #   kubectl logs <pod> -c frontend

          image: ТВОЙ_USERNAME/frontend:1.0
          # ^ ЗАПОЛНИ: какой образ запускать.
          #   После docker push в Docker Hub впиши сюда, например:
          #     image: ivan123/frontend:1.0
          #   Ноды скачают образ по этому имени из registry.
          #   ТЕГ не latest! Конкретная версия (1.0) — чтобы
          #   контролировать, что именно запущено.

          imagePullPolicy: IfNotPresent
          # ^ ДОБАВЛЕНО (рекомендуется): не качать образ заново,
          #   если он уже есть на ноде. Ускоряет и экономит трафик.
          #   Для конкретного тега (не latest) — разумный выбор.

          ports:
            - containerPort: 80
              # ^ ЗАПОЛНЕНО: порт, который слушает приложение ВНУТРИ
              #   контейнера. У nginx в Dockerfile стоит EXPOSE 80 → 80.
              #   Это поле ИНФОРМАТИВНОЕ (документирует порт);
              #   само наружу под не выставляет — для доступа снаружи
              #   нужен Service (отдельный объект).

          resources:
            # resources — сколько ресурсов выделять контейнеру.
            # Важная часть (в твоих заметках — best practice).
            requests:
              # requests — гарантированный МИНИМУМ. Планировщик ставит
              # под на ноду, где есть хотя бы столько свободно.
              memory: "64Mi"
              # ^ 64 мебибайта ОЗУ (минимум).
              cpu: "50m"
              # ^ 50 "милли-CPU" = 0.05 ядра (1000m = 1 ядро).
            limits:
            # ^ ИСПРАВЛЕНО: было "linmits" — опечатка, не работало.
              # limits — жёсткий ПОТОЛОК. Больше контейнер не получит.
              memory: "128Mi"
              # ^ Превысит память → контейнер убивается (OOMKilled).
              cpu: "100m"
              # ^ Превысит CPU → throttling (придушивание скорости).

# ============================================================================
#  ЧТО ЕЩЁ СТОИТ ДОБАВИТЬ (по твоим best practices из конспекта)
# ============================================================================
# 1. ПРОБЫ — чтобы Kubernetes знал, жив ли контейнер и готов ли к трафику.
#    Добавляются внутрь контейнера (на уровень с resources). Для nginx:
#
#          livenessProbe:          # жив ли контейнер; не пройдёт → перезапуск
#            tcpSocket:
#              port: 80
#            initialDelaySeconds: 15
#            periodSeconds: 10
#          readinessProbe:         # готов ли принимать трафик
#            tcpSocket:
#              port: 80
#            initialDelaySeconds: 5
#            periodSeconds: 10
#
# 2. SERVICE — сам Deployment НЕ делает сайт доступным. Нужен отдельный
#    объект Service, чтобы открыть фронт (внутри кластера или наружу через
#    NodePort). Без него браузер до nginx не достучится.
# ============================================================================

# ----------------------------------------------------------------------------
#  ИТОГ: 3 опечатки исправлены (matchLabels, limits, + проверь отступы),
#        2 поля заполнены (image — впиши свой образ; containerPort = 80).
#  Применить:
#     kubectl create namespace my-app          # если ещё нет
#     kubectl apply -f frontend-deployment.yaml
#     kubectl get pods -n my-app -w
# ----------------------------------------------------------------------------